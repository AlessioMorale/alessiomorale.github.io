{% comment %}
    text links to the social profiles listed in _data/socialmedia.yml
{% endcomment %}
<ul class="social-links" aria-label="Profiles">
{% for social_item in site.data.socialmedia %}
    <li><a href="{{ social_item.url | replace: 'http://', 'https://' }}" target="_blank" rel="noopener noreferrer">{{ social_item.name }}</a></li>
{% endfor %}
</ul>
